{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend for Full Stack Web3 App",
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "build": "bun build src/server.ts --outdir dist --target node",
    "start": "bun run dist/server.js",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "knip": "knip"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.2",
    "knip": "^5.67.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.0.0",
    "viem": "^2.38.3",
    "zod": "^4.1.12"
  }
}